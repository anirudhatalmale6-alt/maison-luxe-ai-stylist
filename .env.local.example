# ── AWS Bedrock (REQUIRED — fill in your own keys) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── Bedrock model for chat generation ──
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ── ChromaDB vector database (Docker) ──
CHROMADB_URL=http://127.0.0.1:8000
CHROMA_COLLECTION_NAME=shopping-catalog

# ── Embedding model (AWS Titan) ──
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ── Optional external escalation webhook (leave blank if unused) ──
ESCALATION_WEBHOOK_URL=
